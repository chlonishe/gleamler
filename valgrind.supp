{
   rust-thread-info-reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   fun:std::sys::pal::unix::stack_overflow::thread_info::set_current_info
   ...
}

{
   rust-dlopen-reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:_dl_open
   ...
}

{
   rust-possibly-lost-malloc
   Memcheck:Leak
   match-leak-kinds: possibly-lost
   fun:malloc
   ...
}